{
  "name": "ucp-supplier-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Reference UCP and MCP supplier endpoint for B2B commerce backends (SAP Commerce OCC): account pricing, carts and quotes for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ucp",
    "universal-commerce-protocol",
    "mcp",
    "agentic-commerce",
    "b2b",
    "sap-commerce",
    "occ"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "tsx conformance/cli.ts",
    "build:conformance": "tsx scripts/build-conformance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
